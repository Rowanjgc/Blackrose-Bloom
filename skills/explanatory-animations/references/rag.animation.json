    {
      "time": 0,
      "text": "1. Start with a question that needs evidence from your documents."
    },
    {
      "time": 2,
      "text": "2. Search the index for passages related to the question."
    },
    {
      "time": 4,
      "text": "3. Select Doc A and Doc C as relevant evidence; leave Doc B out."
    },
    {
      "time": 7,
      "text": "4. Send the question and selected passages to the language model."
    },
    {
      "time": 10,
      "text": "5. Generate an answer grounded in those passages. Check its citations."
    }
  ]
